{
  "name": "ui-kit",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @nphuonha/ui-demo",
    "build": "npm run build -w @nphuonha/ui-demo",
    "build:kit": "npm run build -w @nphuonha/ui-kit",
    "typecheck": "npm run typecheck -w @nphuonha/ui-kit && npm run typecheck -w @nphuonha/ui-demo",
    "publish:kit": "npm publish -w @nphuonha/ui-kit"
  }
}
