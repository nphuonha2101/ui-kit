{
  "name": "@nphuonha/ui-kit",
  "version": "0.1.0",
  "description": "Solid, clean, flat, modern React UI kit (Base UI + Tailwind v4).",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./alert": "./src/components/ui/alert/index.ts",
    "./badge": "./src/components/ui/badge/index.ts",
    "./button": "./src/components/ui/button/index.ts",
    "./card": "./src/components/ui/card/index.ts",
    "./checkbox": "./src/components/ui/checkbox/index.ts",
    "./dialog": "./src/components/ui/dialog/index.ts",
    "./field": "./src/components/ui/field/index.ts",
    "./icon-button": "./src/components/ui/icon-button/index.ts",
    "./icons": "./src/components/ui/_shared/icon-provider.ts",
    "./input": "./src/components/ui/input/index.ts",
    "./label": "./src/components/ui/label/index.ts",
    "./popover": "./src/components/ui/popover/index.ts",
    "./radio-group": "./src/components/ui/radio-group/index.ts",
    "./select": "./src/components/ui/select/index.ts",
    "./separator": "./src/components/ui/separator/index.ts",
    "./sheet": "./src/components/ui/sheet/index.ts",
    "./spinner": "./src/components/ui/spinner/index.ts",
    "./switch": "./src/components/ui/switch/index.ts",
    "./tabs": "./src/components/ui/tabs/index.ts",
    "./textarea": "./src/components/ui/textarea/index.ts",
    "./toast": "./src/components/ui/toast/index.ts",
    "./tooltip": "./src/components/ui/tooltip/index.ts",
    "./styles.css": "./src/styles.css",
    "./base.css": "./src/styles/base.css",
    "./theme.css": "./src/styles/theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": ">=4"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
